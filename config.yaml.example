# ========================================
# 모드 선택: github 또는 local_git 중 하나만 enabled: true로 설정
# ========================================

github:
  # GitHub API 모드 활성화 여부 (true/false)
  enabled: false

  # GitHub Personal Access Token (필수)
  # GitHub → Settings → Developer settings → Personal access tokens → Generate new token
  # 필요한 권한: repo (private repo 접근시), read:org
  token: "your_github_token_here"

  # 조회할 조직 목록
  organizations: ["your_organization_name"]

  # 커밋 필터링용 사용자명 목록
  usernames: ["your_username", "teammate1", "teammate2"]

# 로컬 Git 레포지토리 스캔 모드
local_git:
  # 로컬 Git 모드 활성화 여부 (true/false)
  enabled: true

  # 방법 1: 레포지토리들이 있는 디렉토리 지정 (자동 발견)
  # 해당 디렉토리 내의 모든 Git 레포지토리를 자동으로 스캔
  base_paths:
    - "/home/user/workspace"
    - "/home/user/projects"

  # 방법 2: 특정 레포지토리 경로 직접 지정
  # base_paths와 repositories 중 하나만 사용하거나, 둘 다 사용 가능
  # repositories:
  #   - "/home/user/workspace/project-1"
  #   - "/home/user/workspace/project-2"

  # 커밋 필터링용 사용자명 목록 (Git author name 기준)
  # git config user.name으로 설정한 이름과 일치해야 함
  usernames: ["your_username", "teammate1", "teammate2"]

# 브랜치 선택 전략
branch_strategy:
  # 모드: "all", "specific", "priority"
  # all: 모든 존재 브랜치에서 수집 (중복 허용)
  # specific: 지정된 브랜치들에서만 수집
  # priority: 우선순위 순서로 첫 번째 존재 브랜치만 선택 (중복 제거)
  mode: "priority"

  # specific/priority 모드용 브랜치 목록
  # priority 모드: 첫 번째로 존재하는 브랜치만 선택
  # specific 모드: 나열된 모든 브랜치에서 수집
  branches: ["main", "master", "develop"]

  # 레포지토리별 브랜치 전략 오버라이드 (선택사항)
  # 특정 레포지토리에 대해 다른 브랜치 전략을 적용하고 싶을 때 사용
  # 레포지토리명은 반드시 "organization/repository" 전체 형식으로 명시
  # overrides:
  #   "your_organization/repo-name-1":
  #     mode: "specific"
  #     branches: ["release", "hotfix"]
  #   "your_organization/repo-name-2":
  #     mode: "all"

# 조회 기간 설정
date_range:
  # 시작 날짜 (YYYY-MM-DD 형식, 빈값이면 어제부터)
  # 어제가 주말이면 금요일부터 조회할지 물어봄
  from: ""

  # 종료 날짜 (YYYY-MM-DD 형식, 빈값이면 지금까지)
  to: ""